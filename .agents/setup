#!/usr/bin/env bash
# Prepares a fresh Amp orb: Hugo (pinned to CI's version), the theme submodule,
# and the OldRivs app's npm dependencies and Playwright browser.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

HUGO_VERSION="0.139.2" # Keep in sync with .github/workflows/gh-pages.yml

step() { echo "==> $*"; }
timed() { local start=$SECONDS; "$@"; echo "    done in $((SECONDS - start))s"; }

install_hugo() {
	if command -v hugo >/dev/null && hugo version | grep -q "v${HUGO_VERSION}-.*+extended"; then
		echo "    hugo ${HUGO_VERSION} extended already installed"
		return
	fi
	local tmp
	tmp="$(mktemp -d)"
	curl -fsSL "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz" |
		tar -xz -C "$tmp" hugo
	mkdir -p "$HOME/.local/bin"
	mv "$tmp/hugo" "$HOME/.local/bin/hugo"
	rm -rf "$tmp"
	"$HOME/.local/bin/hugo" version
}

step "Hugo ${HUGO_VERSION} extended"
timed install_hugo

step "Theme submodule"
timed git submodule update --init --recursive

step "OldRivs npm dependencies"
cd apps/OldRivs
timed npm ci --no-audit --no-fund

step "Playwright Chromium for e2e tests"
timed npx playwright install chromium
# Install system libraries only when Chromium cannot launch, to skip apt-get on warm runs.
if ! node -e 'require("@playwright/test").chromium.launch().then((b) => b.close())' >/dev/null 2>&1; then
	timed npx playwright install-deps chromium
fi
